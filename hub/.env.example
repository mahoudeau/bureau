# Bureau: environment
BUREAU_TOKEN=change-me-long-random-string
PORT=8100
# HOST=::                       # some shared hosts expect an IPv6 bind (default)
# DISCORD_WEBHOOK_URL=          # optional: mirror notable events to a channel
# BUREAU_PUBLIC_URL=            # public base URL; enables approve/send-back links in review pings
# BUREAU_POKES=                 # optional: outbound wake-up pokes (the summoner), JSON array of subscriptions, e.g.
#   [{"url":"https://…","headers":{"X-Key":"…"},"events":["task.review"],"filter":{"gate":"critic"}}]
#   events may include "work.waiting" (standing-work bell, sweep-driven): add
#   "unless_seen":{"agents":["name"],"within_min":10} and "every_min":30 to keep it polite.
# BUREAU_SWEEP_MS=60000         # sweep cadence (lease expiry + standing-work bell)
# BUREAU_DATA_DIR=./data            # state.json location
# BUREAU_BRAIN_DIR=./brain          # knowledge git repo location
