# Bureau: environment
# Required. The hub refuses to start with no token, or with this placeholder.
BUREAU_TOKEN=change-me-long-random-string
# BUREAU_BOSS_TOKEN=               # turns strict mode on: only this token acts as the boss. Sign the dashboard in with it. Fresh installs should set it (README, "Run it"). Then BUREAU_TOKEN only acts as an agent, and can be removed once every agent has its own token (hub/tools/token.js)
PORT=8100
# HOST=127.0.0.1                # the default: this machine only. To serve others, set 0.0.0.0, or :: on hosts that want IPv6
# BUREAU_ALLOWED_ORIGINS=       # comma-separated browser origins allowed to call the API. Same origin always works
# BUREAU_ALLOW_INSECURE_LOCAL=1 # local demos only: start with no real token, on loopback
# BUREAU_PUBLIC_URL=            # the hub's public address (https://...). Sign-in needs it
# Sign-in (docs/protocol.md, "Sign-in"). With OMAKO, pair the hub instead of setting the
# issuer and client: node hub/tools/omako.js pair. With another issuer, register a client
# there with the redirect <BUREAU_PUBLIC_URL>/auth/callback and set:
# BUREAU_OIDC_ISSUER=https://id.omako.dev   # or any OAuth 2.1 / OpenID issuer
# BUREAU_OIDC_CLIENT_ID=                    # the dashboard's client at that issuer
# BUREAU_OIDC_CLIENT_SECRET=                # its secret; leave out for a public PKCE client
# BUREAU_OIDC_OWNERS=you@example.com        # who owns this hub: emails or the issuer's subject ids
# BUREAU_OIDC_SCOPE=bureau                  # the scope an agent's token must carry
# BUREAU_OIDC_CLI_CLIENT_ID=bureau-cli      # the CLI's client at that issuer (bureau login)
# BUREAU_POKES=                 # optional: outbound wake-up pokes (the summoner), JSON array of subscriptions, e.g.
#   [{"url":"https://…","headers":{"X-Key":"…"},"events":["task.review"],"filter":{"gate":"critic"}}]
#   events may include "work.waiting" (standing-work bell, sweep-driven): add
#   "unless_seen":{"agents":["name"],"within_min":10} and "every_min":30 to keep it polite.
# BUREAU_SWEEP_MS=60000         # sweep cadence (lease expiry + standing-work bell)
# BUREAU_RESERVATION_TTL_MIN=30 # minutes a cowork worker's reservation holds before the pool may take the mission
# BUREAU_DATA_DIR=./data            # state.json location
# BUREAU_BACKUP_INTERVAL_MS=3600000 # rolling state.json.bak.N cadence (hourly)
# BUREAU_BACKUP_KEEP=24             # rolling backups kept
# BUREAU_DAILY_KEEP=7               # daily snapshots kept
# BUREAU_BRAIN_DIR=./brain          # knowledge git repo location
# BUREAU_WORK_DIR=./work            # work store: open missions' evidence, plain files, deleted when a mission closes
